# Copy to backend/.env (never commit .env). PAPER ONLY: no broker/account keys are accepted.

# --- Stock Office ---
STOCK_OFFICE_PAPER_ONLY=true            # cannot be set to false (validated at startup)
STOCK_OFFICE_DATA_DIR=data              # run logs, events.jsonl, snapshots (git-ignored)
STOCK_OFFICE_WORKER_MODE=thread         # thread | external (python -m stock_office.worker)

# --- TradingAgents engine (v0.6.0 @ 1394a3f) ---
STOCK_OFFICE_TA_LLM_PROVIDER=openai     # openai | anthropic | google
STOCK_OFFICE_TA_DEEP_THINK_LLM=         # empty = upstream default
STOCK_OFFICE_TA_QUICK_THINK_LLM=
STOCK_OFFICE_TA_ANALYSTS=market,news,fundamentals
OPENAI_API_KEY=                         # read by upstream; required for engine=tradingagents
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Read-only Korean disclosures (OpenDART) ---
STOCK_OFFICE_DART_API_KEY=
