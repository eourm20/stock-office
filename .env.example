# Copy to backend/.env (never commit .env). PAPER ONLY: no broker/account keys are accepted.

# --- Stock Office ---
STOCK_OFFICE_PAPER_ONLY=true            # cannot be set to false (validated at startup)
STOCK_OFFICE_DATA_DIR=data              # run logs, events.jsonl, snapshots (git-ignored)
STOCK_OFFICE_WORKER_MODE=thread         # thread | external (python -m stock_office.worker)
STOCK_OFFICE_CORS_ORIGINS=http://localhost:3000   # office UI origin(s), comma-separated

# --- TradingAgents engine (v0.6.0 @ 1394a3f) ---
STOCK_OFFICE_TA_LLM_PROVIDER=openai     # openai | anthropic | google
STOCK_OFFICE_TA_DEEP_THINK_LLM=         # empty = upstream default
STOCK_OFFICE_TA_QUICK_THINK_LLM=
STOCK_OFFICE_TA_ANALYSTS=market,news,fundamentals
STOCK_OFFICE_TA_OUTPUT_LANGUAGE=Korean  # reports/debate language (rating line stays English)
STOCK_OFFICE_TA_COST_PROFILE=economy    # economy (dev/test default) | standard (acceptance/evaluation)
# TRADINGAGENTS_* variables also change upstream behaviour; they are folded into config_hash.
OPENAI_API_KEY=                         # read by upstream; required for engine=tradingagents
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Read-only Korean disclosures (OpenDART) ---
STOCK_OFFICE_DART_API_KEY=
# --- Optional: FRED macro data for the News Analyst (read by upstream) ---
FRED_API_KEY=

# --- Paid test guard: real LLM runs in `pytest -m live` happen only when this is 1 ---
STOCK_OFFICE_ALLOW_PAID_TESTS=0
# STOCK_OFFICE_PAID_TEST_INSTRUMENTS=US:NASDAQ:NVDA

# --- Read-only Korean press headlines (Naver Search API, developers.naver.com) ---
STOCK_OFFICE_NAVER_CLIENT_ID=
STOCK_OFFICE_NAVER_CLIENT_SECRET=

# --- Kiwoom 모의투자 (mock trading only; never real-account keys) ---
# Mock app keys from openapi.kiwoom.com "모의투자 App Key 관리"; allow the server IP there.
STOCK_OFFICE_KIWOOM_MOCK_APP_KEY=
STOCK_OFFICE_KIWOOM_MOCK_APP_SECRET=
# Overseas mock account (if it has its own key pair; otherwise the domestic pair is used)
STOCK_OFFICE_KIWOOM_MOCK_US_APP_KEY=
STOCK_OFFICE_KIWOOM_MOCK_US_APP_SECRET=

# --- Phone notifications (Web Push) ---
# Generate once on the server: .venv/bin/python -m stock_office.notify keys >> .env
STOCK_OFFICE_VAPID_PUBLIC_KEY=
STOCK_OFFICE_VAPID_PRIVATE_KEY=
# Quiet hours, Korea time (notifications wait and arrive as one summary)
# STOCK_OFFICE_NOTIFY_QUIET_START=23
# STOCK_OFFICE_NOTIFY_QUIET_END=7
